<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-independent SDK core the way Unity does: .NET Standard 2.1, C# 9. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Playcal.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../com.playcal.sdk/Runtime/Core/*.cs" />
  </ItemGroup>
</Project>
